---
import { Icon } from "astro-icon/components";
import { LEGAL_NAME, SITE_CONTACT } from "../consts";
import FloatingPanel from "./floating_panel.astro";

const today = new Date();
---

<FloatingPanel shadow="t">
  <footer class="py-8">
    <slot />

    <div class="flex justify-center w-full gap-8 pb-8">
      <a
        class="block w-fit rounded-full bg-gray-200 hover:bg-gray-300 p-2.5"
        href={SITE_CONTACT.facebook}
      >
        <Icon class="size-6 text-gray-700" name="facebook" />
      </a>
      <a
        class="block w-fit rounded-full bg-gray-200 hover:bg-gray-300 p-2.5"
        href={SITE_CONTACT.linkedin}
      >
        <Icon class="size-6 text-gray-700" name="linkedin" />
      </a>
    </div>

    <div class="text-center text-sm text-gray-600">
      &copy; Copyright 2016 - {today.getFullYear()}
      {LEGAL_NAME}
      | <a class="text-blue-600 hover:underline" href="/privacy-policy"
        >Privacy Policy</a
      >
      | <a class="text-blue-600 hover:underline" href="/terms-of-service"
        >Terms of Service</a
      >
    </div>
  </footer>
</FloatingPanel>

---
interface Props {
  siteKey: string;
}
const { siteKey } = Astro.props;
---

<!-- Google tag (gtag.js) -->
<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${siteKey}`}></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", siteKey);
</script>

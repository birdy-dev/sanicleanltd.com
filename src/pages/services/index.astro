---
import Container from "@/components/container.astro";
import Layout from "../_layout.astro";
import { Image } from "astro:assets";

import servicesBanner from "../../images/services/services_banner.jpg";
import commercialCleaning from "../../images/services/commercial_cleaning.jpg";
import janitorialServices from "../../images/services/janitorial_services.png";

import { getStaticPaths } from "./[...slug].astro";
import { Icon } from "astro-icon/components";
import Heading from "@/components/ui/heading.astro";
import FloatingPanel from "@/components/floating_panel.astro";
import { P } from "@/components/ui/text";

const paths = await getStaticPaths();
const fullyQualifiedPaths = paths
  .filter((path) => !path.props.city)
  .map((path) => {
    return {
      href: `${Astro.originPathname}/${path.params.slug}`,
      label: path.props.service.data.title,
      image: path.props.service.data.image,
    };
  });

const servicesByCategory = {
  "Restroom and Hygiene Services": [
    "Cleaning and sanitizing washrooms",
    "High touch surface disinfection",
    "Replenishing restroom supplies",
    "Cleaning staff locker rooms and change areas",
  ],
  "Floor Care Services": [
    "Sweeping and dust mopping",
    "Wet mopping and scrubbing floors",
    "Vacuuming carpets and mats",
    "Carpet cleaning",
    "Floor stripping and waxing",
    "Machine polishing and buffing of hard floors",
  ],
  "Surface and Common Area Cleaning": [
    "Cleaning kitchens and lunchrooms",
    "Wiping and sanitation of shared surfaces",
    "Cleaning interior glass, mirrors, and glass partitions",
    "Cleaning walls and doors",
    "Collecting and removing garbage and recycling",
    "Dusting and cleaning ledges, vents, and fixtures",
  ],
  "Speciality and Additional Services": [
    "Window cleaning",
    "Day porter services for daytime cleaning and on demand services",
    "Elevator and stairwell cleaning",
    "After construction cleaning",
    "Restocking kitchen supplies",
    "Cleaning of light fixtures",
  ],
};
---

<Layout title="Services" description="">
  <FloatingPanel shadow="y">
    <Container>
      <Heading>Our Services</Heading>
    </Container>
  </FloatingPanel>

  <Container class="bg-gray-100">
    <div class="space-y-38 pt-16 pb-24">
      <section class="mx-auto max-w-screen-md" id="Why Saniclean">
        <div class="text-center py-4">
          <Heading level="h2">Why Saniclean?</Heading>
        </div>
        <div class="space-y-4">
          <P>
            At Saniclean, we take the time to understand your business, your
            facility, and your cleaning priorities. We begin with a site walk
            through to assess your needs and design a customized cleaning plan
            tailored to your space, schedule, and operations.
          </P>

          <P>
            We work with you to address any concerns, review your hours of
            operation, and incorporate your specific requirements into your
            service plan. If available, we will review your facility floor plan
            to help identify cleaning priorities and ensure efficiency and
            safety for both your staff and ours.
          </P>

          <P>
            Our team also manages and supplies consumable products such as hand
            soap, paper towels, toilet paper, garbage bags, and recycling bags,
            ensuring your inventory stays fully stocked based on your usage and
            preferences.
          </P>
        </div>
      </section>

      <section class="space-y-8">
        <div class="flex flex-col md:grid grid-cols-2 gap-y-8 gap-x-16">
          <Image
            class="border-b-8 border-background w-full object-cover object-center max-h-70 md:max-h-none aspect-[2/3] lg:aspect-[3/2] rounded-lg"
            src={servicesBanner}
            height="500"
            width="338"
            alt="Saniclean employee cleaning a mirror"
          />
          <div class="text-lg space-y-4">
            <P>
              Our staff are thoroughly trained, with ongoing instruction to
              ensure consistent service, safe work practices, and compliance
              with all safety protocols. All employees complete WHMIS training
              and participate in site specific orientations to understand the
              unique needs and safety requirements of each location.
            </P>

            <P>
              We provide regular supervision and quality checks to maintain high
              standards on every site.
            </P>

            <P>
              We value open communication and offer a 24 hour call service for
              urgent needs. Our team members also meet required security
              clearances based on site requirements.
            </P>

            <P>
              For added professionalism and identification, our staff wear
              uniforms while working on your premises.
            </P>
          </div>
        </div>
        <div class="rounded-lg bg-white py-4 space-y-2">
          <p class="text-gray-500 text-center">
            Offering services within Western Canada
          </p>
          <div class="flex items-center justify-center gap-4">
            <span
              class="px-4 py-2 bg-brand-100 text-brand-800 rounded-full text-lg font-medium"
              >Alberta</span
            >
            <span
              class="px-4 py-2 bg-brand-100 text-brand-800 rounded-full text-lg font-medium"
              >British Columbia</span
            >
          </div>
        </div>
      </section>

      <section class="grid lg:grid-cols-2 gap-16">
        <div>
          <h2 class="inline-block text-brand-700 text-2xl font-light">
            Commercial Cleaning
          </h2>
          <hr class="border-brand-600 my-4" />
          <div class="flex flex-col md:flex-row gap-8">
            <Image
              class="aspect-square object-cover w-full max-h-60 min-w-60 md:size-60 overflow-clip rounded-lg"
              src={commercialCleaning}
              height="600"
              width="600"
              alt="Commercial Cleaning"
            />
            <div class="space-y-4">
              <P>
                Saniclean specializes in reliable commercial cleaning services
                tailored to your business. We offer flexible recurring cleaning
                plans designed to meet your specific needs and budget while
                keeping your facility clean, professional, and well maintained.
              </P>
            </div>
          </div>
        </div>

        <div>
          <h2 class="inline-block text-brand-700 text-2xl font-light">
            Janitorial Services
          </h2>
          <hr class="border-brand-600 my-4" />
          <div class="flex flex-col md:flex-row gap-8">
            <Image
              class="aspect-square object-cover w-full max-h-60 min-w-60 md:size-60 overflow-clip rounded-lg"
              src={janitorialServices}
              height="600"
              width="600"
              alt="Janitorial Services"
            />
            <P className="">
              Our services include detailed janitorial care, sanitation, and
              disinfecting of high touch areas throughout offices, lobbies,
              restrooms, and shared spaces. We proudly offer eco friendly
              cleaning products upon request, helping you maintain a healthy and
              welcoming environment for staff and visitors while supporting
              sustainability.
            </P>
          </div>
        </div>
      </section>

      <section>
        <div class="text-center py-4">
          <Heading level="h2">Serving a variety of businesses</Heading>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 md:gap-8">
          {
            fullyQualifiedPaths.map((path) => (
              <div>
                <a
                  class="group relative flex items-center justify-center rounded-lg overflow-clip"
                  href={path.href}
                >
                  <Image
                    class="object-center object-cover group-hover:scale-110 transition-transform h-64"
                    src={path.image}
                    width={450}
                    height={300}
                    alt={path.label}
                  />
                  <div class="absolute flex items-center justify-center inset-0 backdrop-contrast-70 group-hover:backdrop-contrast-90 transition-all bg-gray-900/40">
                    <span class="text-center text-white text-2xl sm:text-3xl font-medium px-4">
                      {path.label}
                    </span>
                  </div>
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <div>
          <h2 class="inline-block text-brand-700 text-2xl font-light">
            Services
          </h2>
          <hr class="border-brand-600 my-4" />
        </div>

        <div class="grid grid-cols-2 gap-8">
          {
            Object.entries(servicesByCategory).map(([category, services]) => (
              <div>
                <h3 class="text-xl text-brand-700 font-light mb-2">
                  {category}
                </h3>
                <ul>
                  {services.map((service) => (
                    <li class="text-lg text-gray-600 py-1 space-x-1 md:space-x-2">
                      <Icon
                        class="inline-block h-6 w-6 text-brand-600"
                        name="circle-check"
                      />
                      <span>{service}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </Container>
</Layout>
